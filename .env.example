# Copia questo file in .env e modificalo se serve. Dopo una modifica:
#   sudo systemctl restart jetson-ai-server

# Indirizzo e porta del server
JAS_HOST=0.0.0.0
JAS_PORT=8000

# Dove salvare database, file caricati, risultati e modelli
# JAS_DATA_DIR=/home/utente/jetson-ai-server/data

# Dimensione massima di un file caricato (MB)
JAS_MAX_UPLOAD_MB=4096

# Durata del login (ore)
JAS_SESSION_HOURS=168

# LLM locale (Ollama). Alternative leggere: llama3.2:3b, gemma3:4b, qwen2.5:1.5b
JAS_OLLAMA_URL=http://127.0.0.1:11434
JAS_LLM_MODEL=qwen2.5:3b
JAS_EMBED_MODEL=nomic-embed-text
JAS_LLM_CONTEXT=8192
# Quanto resta in memoria l'LLM dopo l'ultima domanda
JAS_OLLAMA_KEEP_ALIVE=5m

# YOLO: ottimizzazione TensorRT dei modelli (auto | on | off)
JAS_TENSORRT=auto

# Lingue dell'OCR (pacchetti tesseract-ocr-ita, tesseract-ocr-eng, ...)
JAS_OCR_LANG=ita+eng

# Cartelle con plugin aggiuntivi (separate da ':')
# JAS_PLUGIN_DIRS=/home/utente/jetson-ai-server/plugins
