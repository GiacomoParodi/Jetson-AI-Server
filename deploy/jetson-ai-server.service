[Unit]
Description=Jetson AI Server (YOLO e LLM locali)
After=network-online.target ollama.service
Wants=network-online.target ollama.service

[Service]
Type=simple
User=__USER__
WorkingDirectory=__DIR__
EnvironmentFile=-__DIR__/.env
ExecStart=__DIR__/.venv/bin/python -m app
Restart=always
RestartSec=5
# Lascia memoria al sistema se un modello esagera, invece di bloccare il Jetson.
OOMScoreAdjust=200

[Install]
WantedBy=multi-user.target
